<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.08 0 0.065"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.025 0.025"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.15 0 0.03"/>
  </joint>

  <!-- REP-103 optical convention: z forward, x right, y down. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-${pi / 2} 0 -${pi / 2}"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry><box size="0.03 0.03 0.01"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.055"/>
  </joint>
</robot>
