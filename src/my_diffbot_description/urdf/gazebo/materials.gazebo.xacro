  <gazebo reference="laser_link"><material>Gazebo/Red</material></gazebo>
  <gazebo reference="camera_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="imu_link"><material>Gazebo/Green</material></gazebo>
